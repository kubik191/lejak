# Copy to .env and adjust. Every setting is optional; defaults are shown.

# --- General ---------------------------------------------------------------
# TIMEZONE=Europe/Bratislava
# PUBLIC_URL=http://localhost:8000          # used for links in alert emails
# DATABASE_URL=                             # default: SQLite file in ./data/collector.db

# --- Politeness towards shmu.sk --------------------------------------------
# HTTP_CONCURRENCY=4                         # parallel requests
# HTTP_MIN_DELAY=0.4                         # seconds between request starts
# HTTP_TIMEOUT=30
# HTTP_RETRIES=3

# --- Health rules ----------------------------------------------------------
# FAILING_AFTER=3                            # failures in a row before a station is "failing" (and alerted)
# STALE_DATA_HOURS=24                        # no new data for this long = "no new data"
# RUN_RETENTION_DAYS=90                      # run history kept (measurements are kept forever)

# --- Email alerts (leave SMTP_HOST empty to disable) -----------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# ALERT_FROM=you@gmail.com
# ALERT_TO=you@gmail.com,colleague@example.com
# ALERT_FAILURE_RATIO=0.2                    # alert when >= 20 % of stations in a run fail
